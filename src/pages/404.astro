---
import MarkdownLayout from "@/layouts/MarkdownLayout.astro";

const base = import.meta.env.BASE_URL;
---

<MarkdownLayout title="404 - Page Not Found" slug="404" toc={[]}>
  <div class="error-page">
    <h1 class="error-title">404</h1>
    <p class="error-message">Document Not Found</p>
    <p class="error-description">
      The requested document doesn't exist in the content directory.
    </p>
    <a href={base} class="button-primary">← Back to Home</a>
  </div>
</MarkdownLayout>

<style>
  .error-page {
    text-align: center;
    padding: 2rem 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .error-title {
    font-size: 8rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    line-height: 1;
  }

  .error-message {
    font-size: 2rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem 0;
    color: var(--text-secondary);
  }

  .error-description {
    font-size: 1.125rem;
    margin: 0.75rem 0;
    color: var(--text-secondary);
  }

  .button-primary {
    display: inline-block;
    padding: 0.75rem 2rem;
    margin-top: 1.5rem;
    background: var(--clay-bg);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 12px;
    font-weight: 600;
    box-shadow:
      6px 6px 12px var(--clay-shadow-dark),
      -6px -6px 12px var(--clay-shadow-light);
    transition: all 0.2s ease;
  }

  .button-primary:hover {
    box-shadow:
      4px 4px 8px var(--clay-shadow-dark),
      -4px -4px 8px var(--clay-shadow-light);
    transform: translateY(2px);
  }
</style>
