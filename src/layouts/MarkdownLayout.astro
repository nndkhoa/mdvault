---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import type { TOCItem } from "@/lib/toc";

import "@/styles/global.css";
import "@/styles/claymorphism.css";

interface Props {
  title: string;
  slug: string;
  toc: TOCItem[];
}

const { title, slug, toc } = Astro.props;
const pageTitle = title ? `${title} - MDVault` : "MDVault";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Beautiful markdown viewer for GitHub Pages"
    />

    <!-- KaTeX CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />

    <!-- Prevent theme flash -->
    <script is:inline>
      function initTheme() {
        const saved = localStorage.getItem("mdvault-theme");
        const theme = saved === "dark" || saved === "light" ? saved : "light";
        document.documentElement.setAttribute("data-theme", theme);
      }
      initTheme();
    </script>

    <!-- Highlight.js for syntax highlighting -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/styles/github.min.css"
      id="hljs-light"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/styles/github-dark.min.css"
      id="hljs-dark"
      disabled
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/highlight.min.js"
    ></script>
    <script is:inline>
      // Update highlight.js theme based on app theme
      function updateHighlightTheme() {
        const theme = document.documentElement.getAttribute("data-theme");
        const lightTheme = document.getElementById("hljs-light");
        const darkTheme = document.getElementById("hljs-dark");

        if (theme === "dark") {
          lightTheme.disabled = true;
          darkTheme.disabled = false;
        } else {
          lightTheme.disabled = false;
          darkTheme.disabled = true;
        }
      }

      // Initialize highlight.js and set theme
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("pre code").forEach((block) => {
          hljs.highlightElement(block);
        });
        updateHighlightTheme();
      });

      // Watch for theme changes
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === "data-theme") {
            updateHighlightTheme();
          }
        });
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />
    <Breadcrumbs slug={slug} />

    <div class="layout-container">
      <div class="content-wrapper">
        <TableOfContents toc={toc} />

        <main id="main" role="main" class="main-content">
          <slot />
        </main>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--accent-primary);
    color: white;
    padding: 8px;
    text-decoration: none;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
  }

  .skip-link:focus {
    top: 0;
    opacity: 1;
    pointer-events: auto;
  }

  .layout-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .main-content {
    min-width: 0;
    background: var(--clay-bg);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid var(--clay-border);
    box-shadow:
      8px 8px 16px var(--clay-shadow-dark),
      -8px -8px 16px var(--clay-shadow-light);
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .main-content {
      padding: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .layout-container {
      padding: 1rem;
    }

    .main-content {
      padding: 1rem;
      border-radius: 12px;
    }
  }
</style>
