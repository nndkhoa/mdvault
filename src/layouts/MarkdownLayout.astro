---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import type { TOCItem } from "@/lib/toc";

import "@/styles/global.css";
import "@/styles/claymorphism.css";

interface Props {
  title: string;
  slug: string;
  toc: TOCItem[];
}

const { title, slug, toc } = Astro.props;
const pageTitle = title ? `${title} - MDVault` : "MDVault";
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Beautiful markdown viewer for GitHub Pages"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={`${base}favicon-96x96.png`} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="MDVault" />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- KaTeX CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />

    <!-- Prevent theme flash -->
    <script is:inline>
      function initTheme() {
        const saved = localStorage.getItem("mdvault-theme");
        const theme =
          saved === "dark" || saved === "light" || saved === "sepia"
            ? saved
            : "sepia";
        document.documentElement.setAttribute("data-theme", theme);
      }
      initTheme();
    </script>

    <!-- Highlight.js for syntax highlighting -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/styles/github.min.css"
      id="hljs-light"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/styles/github-dark.min.css"
      id="hljs-dark"
      disabled
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/highlight.min.js"
    ></script>
    <!-- Mermaid for diagram rendering -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.min.js"
    ></script>
    <script is:inline>
      // Update highlight.js theme based on app theme
      function updateHighlightTheme() {
        const theme = document.documentElement.getAttribute("data-theme");
        const lightTheme = document.getElementById("hljs-light");
        const darkTheme = document.getElementById("hljs-dark");

        if (theme === "dark") {
          lightTheme.disabled = true;
          darkTheme.disabled = false;
        } else {
          lightTheme.disabled = false;
          darkTheme.disabled = true;
        }
      }

      // Get Mermaid theme based on app theme
      function getMermaidTheme() {
        const theme = document.documentElement.getAttribute("data-theme");
        if (theme === "dark") {
          return "dark";
        } else if (theme === "sepia") {
          return "default"; // Sepia uses default theme
        } else {
          return "default";
        }
      }

      // Initialize Mermaid diagrams
      function initMermaid() {
        if (typeof mermaid === "undefined") {
          return; // Mermaid library not loaded
        }

        // Configure Mermaid
        mermaid.initialize({
          startOnLoad: false,
          theme: getMermaidTheme(),
          securityLevel: "loose",
          fontFamily: "inherit",
        });

        // Find all mermaid code blocks and convert them
        const mermaidBlocks = document.querySelectorAll("pre code.language-mermaid");
        
        if (mermaidBlocks.length === 0) {
          return; // No mermaid blocks found
        }

        // Use Intersection Observer for lazy loading
        const mermaidObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target;
              mermaidObserver.unobserve(element);
              renderMermaidBlock(element);
            }
          });
        }, {
          rootMargin: "50px", // Start loading slightly before visible
        });

        mermaidBlocks.forEach((block) => {
          mermaidObserver.observe(block);
        });
      }

      // Render a single mermaid block
      function renderMermaidBlock(codeBlock) {
        try {
          const mermaidCode = codeBlock.textContent || "";
          const preElement = codeBlock.parentElement;
          
          if (!preElement || !mermaidCode.trim()) {
            return;
          }

          // Create a unique ID for this diagram
          const id = "mermaid-" + Math.random().toString(36).substr(2, 9);
          
          // Create new div for Mermaid
          const mermaidDiv = document.createElement("div");
          mermaidDiv.className = "mermaid";
          mermaidDiv.id = id;
          mermaidDiv.textContent = mermaidCode;
          mermaidDiv.setAttribute("role", "img");
          mermaidDiv.setAttribute("aria-label", "Mermaid diagram");

          // Replace the pre element with mermaid div
          preElement.replaceWith(mermaidDiv);

          // Render the diagram
          mermaid.run({
            nodes: [mermaidDiv],
          }).catch((error) => {
            console.error("Mermaid rendering error:", error);
            // On error, restore the original code block
            const fallbackPre = document.createElement("pre");
            const fallbackCode = document.createElement("code");
            fallbackCode.className = "language-mermaid";
            fallbackCode.textContent = mermaidCode;
            fallbackPre.appendChild(fallbackCode);
            mermaidDiv.replaceWith(fallbackPre);
          });
        } catch (error) {
          console.error("Mermaid initialization error:", error);
        }
      }

      // Update Mermaid theme when app theme changes
      function updateMermaidTheme() {
        if (typeof mermaid === "undefined") {
          return;
        }

        const theme = getMermaidTheme();
        const mermaidDiagrams = document.querySelectorAll(".mermaid");
        
        if (mermaidDiagrams.length > 0) {
          // Re-render all diagrams with new theme
          mermaid.initialize({
            startOnLoad: false,
            theme: theme,
            securityLevel: "loose",
            fontFamily: "inherit",
          });

          mermaidDiagrams.forEach((diagram) => {
            const mermaidCode = diagram.textContent || "";
            if (mermaidCode.trim()) {
              mermaid.run({
                nodes: [diagram],
              }).catch((error) => {
                console.error("Mermaid theme update error:", error);
              });
            }
          });
        }
      }

      // Initialize highlight.js and set theme
      document.addEventListener("DOMContentLoaded", () => {
        // Initialize highlight.js
        document.querySelectorAll("pre code:not(.language-mermaid)").forEach((block) => {
          hljs.highlightElement(block);
        });
        updateHighlightTheme();

        // Initialize Mermaid (with delay to ensure library is loaded)
        setTimeout(() => {
          initMermaid();
        }, 100);
      });

      // Watch for theme changes
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === "data-theme") {
            updateHighlightTheme();
            updateMermaidTheme();
          }
        });
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    </script>

    <!-- TOC Toggle Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.querySelector('.toc-toggle-btn');
        const tocSidebar = document.querySelector('.toc-sidebar');
        
        if (!toggleBtn || !tocSidebar) return;

        // Restore TOC visibility from localStorage
        const savedVisibility = localStorage.getItem('mdvault-toc-visible');
        const isVisible = savedVisibility === null ? true : savedVisibility === 'true';
        
        tocSidebar.setAttribute('data-toc-visible', String(isVisible));
        toggleBtn.setAttribute('aria-pressed', String(!isVisible));
        toggleBtn.setAttribute('aria-label', isVisible ? 'Hide table of contents' : 'Show table of contents');

        // Update HTML attribute for layout
        if (!isVisible) {
          document.documentElement.setAttribute('data-toc-hidden', 'true');
        }

        // Toggle button handler
        toggleBtn.addEventListener('click', () => {
          const currentlyVisible = tocSidebar.getAttribute('data-toc-visible') === 'true';
          const newVisible = !currentlyVisible;
          
          tocSidebar.setAttribute('data-toc-visible', String(newVisible));
          toggleBtn.setAttribute('aria-pressed', String(!newVisible));
          toggleBtn.setAttribute('aria-label', newVisible ? 'Hide table of contents' : 'Show table of contents');
          
          // Save to localStorage
          localStorage.setItem('mdvault-toc-visible', String(newVisible));
          
          // Update layout
          if (newVisible) {
            document.documentElement.removeAttribute('data-toc-hidden');
          } else {
            document.documentElement.setAttribute('data-toc-hidden', 'true');
          }
        });

        // Keyboard support
        toggleBtn.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleBtn.click();
          }
        });
      });
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header slug={slug} showTocToggle={toc.length > 0} />

    <div class="layout-container">
      <div class={`content-wrapper ${toc.length === 0 ? 'no-toc' : ''}`}>
        <TableOfContents toc={toc} />

        <main id="main" role="main" class="main-content">
          <slot />
        </main>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--accent-primary);
    color: white;
    padding: 8px 16px;
    text-decoration: none;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    border-radius: 6px;
    font-weight: 500;
  }

  .skip-link:focus {
    top: 1rem;
    left: 1rem;
    opacity: 1;
    pointer-events: auto;
  }

  .layout-container {
    width: 1400px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 1.5rem;
    flex: 1;
    align-items: flex-start;
    transition: grid-template-columns 0.3s ease;
  }

  .content-wrapper.no-toc {
    grid-template-columns: 1fr;
  }

  .main-content {
    min-width: 0;
    background: var(--bg-elevated);
    padding: 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-primary);
    box-shadow: var(--shadow-sm);
    position: relative;
    grid-column: 2;
  }

  .content-wrapper.no-toc .main-content {
    grid-column: 1;
  }

  /* Custom scrollbar for main content */
  .main-content::-webkit-scrollbar {
    width: 8px;
  }

  .main-content::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: 4px;
  }

  .main-content::-webkit-scrollbar-thumb {
    background: var(--border-secondary);
    border-radius: 4px;
  }

  .main-content::-webkit-scrollbar-thumb:hover {
    background: var(--text-tertiary);
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .main-content {
      padding: 2rem;
    }
  }

  @media (max-width: 1430px) {
    .layout-container {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .layout-container {
      padding: 0.875rem 1rem;
    }

    .main-content {
      padding: 1.5rem;
      border-radius: 10px;
    }
  }
</style>
