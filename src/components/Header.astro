---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a href="/" class="logo">
      <span class="logo-text">MDVault</span>
    </a>
    <ThemeSwitcher />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--clay-bg);
    border-bottom: 1px solid var(--clay-border);
    box-shadow:
      0 4px 6px var(--clay-shadow-dark),
      0 -1px 3px var(--clay-shadow-light);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: var(--clay-bg);
    border-radius: 16px;
    border: 2px solid var(--clay-border);
    box-shadow:
      6px 6px 12px var(--clay-shadow-dark),
      -6px -6px 12px var(--clay-shadow-light);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .logo:hover {
    box-shadow:
      4px 4px 8px var(--clay-shadow-dark),
      -4px -4px 8px var(--clay-shadow-light);
    transform: translateY(1px);
  }

  .logo:active {
    box-shadow:
      inset 3px 3px 6px var(--clay-shadow-dark),
      inset -3px -3px 6px var(--clay-shadow-light);
    transform: translateY(2px);
  }

  .logo-text {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    background: linear-gradient(
      135deg,
      var(--accent-primary) 0%,
      var(--accent-secondary) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
  }

  /* Add subtle glow effect */
  .logo-text::before {
    content: "MDVault";
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(
      135deg,
      var(--accent-primary) 0%,
      var(--accent-secondary) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .logo:hover .logo-text::before {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .logo {
      padding: 0.375rem 1rem;
    }

    .logo-text {
      font-size: 1.25rem;
    }
  }
</style>
