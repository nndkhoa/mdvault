---
import Icon from "./icons/Icon.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;

interface BreadcrumbItem {
  label: string;
  url: string;
  active: boolean;
}

function generateBreadcrumbs(path: string): BreadcrumbItem[] {
  const breadcrumbs: BreadcrumbItem[] = [
    { label: "Home", url: base, active: false },
  ];

  if (!path || path === "" || path === "404") {
    if (path === "404") {
      breadcrumbs.push({ label: "404", url: "/404", active: true });
    } else {
      breadcrumbs[0].active = true;
    }
    return breadcrumbs;
  }

  const parts = path.split("/").filter(Boolean);
  let currentPath = "";

  parts.forEach((part, index) => {
    currentPath += "/" + part;
    const label = part
      .replace(/-/g, " ")
      .replace(/\b\w/g, (l) => l.toUpperCase());

    breadcrumbs.push({
      label,
      url: base + currentPath,
      active: index === parts.length - 1,
    });
  });

  return breadcrumbs;
}

const breadcrumbs = generateBreadcrumbs(slug);
---

<nav aria-label="Breadcrumb" class="breadcrumbs-nav">
  <ol class="breadcrumbs">
    {
      breadcrumbs.map((item, index) => (
        <li class="breadcrumb-item">
          {item.active ? (
            <span aria-current="page" class="breadcrumb-current">
              {index === 0 && (
                <Icon name="home" size="sm" class="breadcrumb-icon" />
              )}
              {item.label}
            </span>
          ) : (
            <>
              <a href={item.url} class="breadcrumb-link">
                {index === 0 && (
                  <Icon name="home" size="sm" class="breadcrumb-icon" />
                )}
                {item.label}
              </a>
              <Icon
                name="chevron-right"
                size="sm"
                class="breadcrumb-separator"
              />
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs-nav {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .breadcrumbs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
  }

  .breadcrumb-link,
  .breadcrumb-current {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .breadcrumb-link {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
    background: var(--bg-secondary);
    transform: translateY(-1px);
  }

  .breadcrumb-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .breadcrumb-icon {
    color: inherit;
  }

  .breadcrumb-separator {
    color: var(--text-tertiary);
    user-select: none;
    flex-shrink: 0;
    opacity: 0.5;
  }

  .breadcrumb-current {
    color: var(--text-secondary);
    font-weight: 500;
    padding: 0.25rem 0.5rem;
  }

  @media (max-width: 768px) {
    .breadcrumbs-nav {
      display: none;
    }
  }
</style>
