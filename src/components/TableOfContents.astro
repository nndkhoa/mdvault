---
import type { TOCItem } from "@/lib/toc";
import Icon from "./icons/Icon.astro";

interface Props {
  toc: TOCItem[];
}

const { toc } = Astro.props;

function renderTOCItem(item: TOCItem) {
  return {
    ...item,
    hasChildren: item.children && item.children.length > 0,
  };
}
---

{
  toc.length > 0 && (
    <aside
      class="toc-sidebar"
      role="complementary"
      aria-label="Table of contents"
      data-toc-visible="true"
    >
      <nav class="toc">
        <div class="toc-header">
          <div class="toc-header-title-wrapper">
            <Icon name="list-bullet" size="md" class="toc-header-icon" />
            <h2 class="toc-title">Contents</h2>
          </div>
          <div class="toc-filter-wrapper">
            <div class="toc-filter-input-wrapper">
              <svg class="toc-filter-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 13C10.3137 13 13 10.3137 13 7C13 3.68629 10.3137 1 7 1C3.68629 1 1 3.68629 1 7C1 10.3137 3.68629 13 7 13Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15 15L11.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <input
                type="text"
                class="toc-filter-input"
                placeholder="Filter sections..."
                aria-label="Filter table of contents"
              />
              <button class="toc-filter-clear" aria-label="Clear filter" type="button" style="display: none;">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
        <ul class="toc-list">
          {toc.map((item) => {
            const tocItem = renderTOCItem(item);
            return (
              <li class="toc-item" data-toc-text={item.text.toLowerCase()}>
                <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
                  {item.text}
                </a>
                {tocItem.hasChildren && (
                  <ul class="toc-list toc-nested">
                    {item.children.map((child) => (
                      <li class="toc-item" data-toc-text={child.text.toLowerCase()}>
                        <a href={`#${child.id}`} class="toc-link" data-toc-id={child.id}>
                          {child.text}
                        </a>
                        {child.children && child.children.length > 0 && (
                          <ul class="toc-list toc-nested">
                            {child.children.map((grandchild) => (
                              <li class="toc-item" data-toc-text={grandchild.text.toLowerCase()}>
                                <a href={`#${grandchild.id}`} class="toc-link" data-toc-id={grandchild.id}>
                                  {grandchild.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
        <div class="toc-no-results" style="display: none;">
          <p>No matching sections</p>
        </div>
      </nav>
    </aside>
  )
}

<style>
  .toc-sidebar {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--bg-elevated);
    border-radius: 12px;
    border: 1px solid var(--border-primary);
    box-shadow: var(--shadow-sm);
    max-height: calc(100vh - 3rem);
    overflow: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .toc-sidebar[data-toc-visible="false"] {
    display: none;
  }

  .toc-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
  }

  .toc-header-title-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-filter-wrapper {
    width: 100%;
  }

  .toc-filter-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .toc-filter-icon {
    position: absolute;
    left: 0.625rem;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .toc-filter-input {
    width: 100%;
    padding: 0.5rem 2rem 0.5rem 2rem;
    border: 1px solid var(--border-primary);
    border-radius: 6px;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 0.8125rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .toc-filter-input::placeholder {
    color: var(--text-tertiary);
  }

  .toc-filter-input:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .toc-filter-clear {
    position: absolute;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text-tertiary);
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .toc-filter-clear:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .toc-filter-clear:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 1px;
  }

  .toc {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .toc-list {
    overflow-y: auto;
    overflow-x: hidden;
    flex: 1;
    margin: 0;
    padding: 0;
  }

  .toc-no-results {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .toc-no-results p {
    margin: 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .toc-header-icon {
    color: var(--accent-primary);
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-nested {
    margin-left: 0.5rem;
    margin-top: 0.25rem;
    padding-left: 0.5rem;
  }

  .toc-item {
    margin-bottom: 0.375rem;
  }

  .toc-link {
    display: block;
    position: relative;
    padding: 0.375rem 0.625rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    line-height: 1.5;
  }

  .toc-link:hover {
    color: var(--accent-primary);
    background: var(--bg-secondary);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .toc-link.active {
    color: var(--accent-primary);
    background: var(--bg-secondary);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .toc-sidebar {
      display: none;
    }
  }

  /* Scrollbar styling for TOC list */
  .toc-list::-webkit-scrollbar {
    width: 5px;
  }

  .toc-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--border-secondary);
    border-radius: 10px;
  }

  .toc-list::-webkit-scrollbar-thumb:hover {
    background: var(--text-tertiary);
  }
</style>

<script>
  // TOC Filter functionality
  (function initTOCControls() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTOCControls);
      return;
    }

    const filterInput = document.querySelector('.toc-filter-input');
    const clearBtn = document.querySelector('.toc-filter-clear');
    const tocItems = document.querySelectorAll('.toc-item');
    const tocList = document.querySelector('.toc-list');
    const noResults = document.querySelector('.toc-no-results');

    if (!filterInput) return;

    // Filter functionality
    function filterTOC(searchText) {
      const query = searchText.toLowerCase().trim();
      
      if (!query) {
        // Show all items
        tocItems.forEach(item => {
          item.style.display = '';
        });
        if (tocList) tocList.style.display = '';
        if (noResults) noResults.style.display = 'none';
        return;
      }

      let hasVisibleItems = false;

      // First pass: mark items that match
      tocItems.forEach(item => {
        const text = item.getAttribute('data-toc-text') || '';
        const matches = text.includes(query);
        item.setAttribute('data-matches', String(matches));
        item.setAttribute('data-visible', 'false');
      });

      // Second pass: show matching items and their parents
      tocItems.forEach(item => {
        const matches = item.getAttribute('data-matches') === 'true';
        
        if (matches) {
          // Show this item
          item.setAttribute('data-visible', 'true');
          item.style.display = '';
          hasVisibleItems = true;
          
          // Show all parent items
          let parent = item.parentElement;
          while (parent) {
            if (parent.classList.contains('toc-item')) {
              parent.setAttribute('data-visible', 'true');
              parent.style.display = '';
            }
            parent = parent.parentElement;
          }
        }
      });

      // Third pass: hide items that aren't visible and don't have visible children
      tocItems.forEach(item => {
        const isVisible = item.getAttribute('data-visible') === 'true';
        
        if (!isVisible) {
          // Check if any descendant is visible
          const hasVisibleDescendant = item.querySelector('[data-visible="true"]') !== null;
          
          if (hasVisibleDescendant) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        }
      });

      // Show/hide no results message
      if (tocList) tocList.style.display = hasVisibleItems ? '' : 'none';
      if (noResults) noResults.style.display = hasVisibleItems ? 'none' : 'flex';
    }

    // Filter input handler
    filterInput.addEventListener('input', (e) => {
      const value = e.target.value;
      filterTOC(value);
      
      // Show/hide clear button
      if (clearBtn) {
        clearBtn.style.display = value ? 'flex' : 'none';
      }
    });

    // Clear button handler
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        filterInput.value = '';
        filterTOC('');
        clearBtn.style.display = 'none';
        filterInput.focus();
      });
    }
  })();

  (function initTOCScrollSync() {
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTOCScrollSync);
      return;
    }

    const tocLinks = document.querySelectorAll('.toc-link[data-toc-id]');
    if (tocLinks.length === 0) return;

    // Get all headings that are in the TOC (H2-H6)
    const headings = Array.from(document.querySelectorAll('h2[id], h3[id], h4[id], h5[id], h6[id]'));
    if (headings.length === 0) return;

    // Create a map of heading IDs to TOC links
    const headingIdToLink = new Map();
    tocLinks.forEach((link) => {
      const id = link.getAttribute('data-toc-id');
      if (id) {
        headingIdToLink.set(id, link);
      }
    });

    let activeHeadingId = null;

    // Function to update active TOC link
    function setActiveTOCLink(headingId) {
      // Remove active class from all links
      tocLinks.forEach((link) => {
        link.classList.remove('active');
        link.setAttribute('aria-current', 'false');
      });

      // Add active class to the current link
      if (headingId) {
        const activeLink = headingIdToLink.get(headingId);
        if (activeLink) {
          activeLink.classList.add('active');
          activeLink.setAttribute('aria-current', 'location');
          
          // Scroll the active link into view within the TOC sidebar
          const tocList = activeLink.closest('.toc-list');
          if (tocList) {
            const linkRect = activeLink.getBoundingClientRect();
            const listRect = tocList.getBoundingClientRect();
            
            // Only scroll if the link is not fully visible
            if (linkRect.top < listRect.top || linkRect.bottom > listRect.bottom) {
              activeLink.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest',
                inline: 'nearest',
              });
            }
          }
        }
      }
    }

    // Intersection Observer options
    // Use a threshold that triggers when heading is near the top of viewport
    const observerOptions = {
      rootMargin: '-20% 0px -70% 0px', // Trigger when heading is in upper 30% of viewport
      threshold: [0, 0.1, 0.5, 1],
    };

    // Track which headings are currently intersecting
    const intersectingHeadings = new Map();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const headingId = entry.target.id;
        if (entry.isIntersecting) {
          // Store the intersection ratio (higher = closer to top)
          intersectingHeadings.set(headingId, entry.intersectionRatio);
        } else {
          intersectingHeadings.delete(headingId);
        }
      });

      // Determine the active heading
      // Prefer headings with higher intersection ratio (closer to top)
      let newActiveId = null;
      let maxRatio = 0;

      intersectingHeadings.forEach((ratio, id) => {
        if (ratio > maxRatio) {
          maxRatio = ratio;
          newActiveId = id;
        }
      });

      // If multiple headings are visible, prefer the one closest to top of viewport
      if (intersectingHeadings.size > 1) {
        const viewportTop = window.scrollY;
        let closestDistance = Infinity;

        headings.forEach((heading) => {
          const id = heading.id;
          if (intersectingHeadings.has(id)) {
            const rect = heading.getBoundingClientRect();
            const distance = Math.abs(rect.top - viewportTop);
            if (distance < closestDistance) {
              closestDistance = distance;
              newActiveId = id;
            }
          }
        });
      }

      // Update active state if changed
      if (newActiveId !== activeHeadingId) {
        activeHeadingId = newActiveId;
        setActiveTOCLink(activeHeadingId);
      }
    }, observerOptions);

    // Observe all headings
    headings.forEach((heading) => {
      observer.observe(heading);
    });

    // Handle initial page load with hash anchor
    function handleInitialHash() {
      const hash = window.location.hash.slice(1); // Remove #
      if (hash && headingIdToLink.has(hash)) {
        // Wait a bit for browser to scroll to anchor, then set active
        setTimeout(() => {
          const targetHeading = document.getElementById(hash);
          if (targetHeading) {
            activeHeadingId = hash;
            setActiveTOCLink(activeHeadingId);
          }
        }, 300);
      } else if (headings.length > 0) {
        // No hash, check if first heading is visible
        setTimeout(() => {
          const firstHeading = headings[0];
          if (firstHeading) {
            const rect = firstHeading.getBoundingClientRect();
            // If first heading is near top of viewport, make it active
            if (rect.top <= window.innerHeight * 0.3 && rect.top >= -100) {
              activeHeadingId = firstHeading.id;
              setActiveTOCLink(activeHeadingId);
            }
          }
        }, 100);
      }
    }

    // Handle hash changes (when user clicks TOC links)
    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.slice(1);
      if (hash && headingIdToLink.has(hash)) {
        setTimeout(() => {
          const targetHeading = document.getElementById(hash);
          if (targetHeading) {
            activeHeadingId = hash;
            setActiveTOCLink(activeHeadingId);
          }
        }, 100);
      }
    });

    // Initialize on page load
    handleInitialHash();

    // Fallback: check scroll position on scroll events (for edge cases)
    let scrollTimeout = null;
    window.addEventListener('scroll', () => {
      if (scrollTimeout !== null) {
        cancelAnimationFrame(scrollTimeout);
      }
      scrollTimeout = requestAnimationFrame(() => {
        // Only update if no headings are intersecting (fallback)
        if (intersectingHeadings.size === 0 && headings.length > 0) {
          const viewportTop = window.scrollY + 100; // Offset for sticky header
          let closestHeading: HTMLElement | null = null;
          let closestDistance = Infinity;

          headings.forEach((heading) => {
            const rect = heading.getBoundingClientRect();
            const headingTop = window.scrollY + rect.top;
            const distance = Math.abs(headingTop - viewportTop);
            
            // Only consider headings above or near the viewport top
            if (headingTop <= viewportTop + 50 && distance < closestDistance) {
              closestDistance = distance;
              closestHeading = heading;
            }
          });

          if (closestHeading && closestHeading.id !== activeHeadingId) {
            activeHeadingId = closestHeading.id;
            setActiveTOCLink(activeHeadingId);
          }
        }
      });
    }, { passive: true });
  })();
</script>
