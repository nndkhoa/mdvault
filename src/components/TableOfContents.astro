---
import type { TOCItem } from '@/lib/toc';

interface Props {
  toc: TOCItem[];
}

const { toc } = Astro.props;

function renderTOCItem(item: TOCItem) {
  return {
    ...item,
    hasChildren: item.children && item.children.length > 0,
  };
}
---

{
  toc.length > 0 && (
    <aside class="toc-sidebar" role="complementary" aria-label="Table of contents">
      <nav class="toc">
        <h2 class="toc-title">Contents</h2>
        <ul class="toc-list">
          {toc.map((item) => {
            const tocItem = renderTOCItem(item);
            return (
              <li class="toc-item">
                <a href={`#${item.id}`} class="toc-link">
                  {item.text}
                </a>
                {tocItem.hasChildren && (
                  <ul class="toc-list toc-nested">
                    {item.children.map((child) => (
                      <li class="toc-item">
                        <a href={`#${child.id}`} class="toc-link">
                          {child.text}
                        </a>
                        {child.children && child.children.length > 0 && (
                          <ul class="toc-list toc-nested">
                            {child.children.map((grandchild) => (
                              <li class="toc-item">
                                <a href={`#${grandchild.id}`} class="toc-link">
                                  {grandchild.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>
  )
}

<style>
  .toc-sidebar {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--clay-bg);
    border-radius: 16px;
    border: 1px solid var(--clay-border);
    box-shadow:
      8px 8px 16px var(--clay-shadow-dark),
      -8px -8px 16px var(--clay-shadow-light);
  }

  .toc-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--clay-border);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-nested {
    margin-left: 1rem;
    margin-top: 0.25rem;
  }

  .toc-item {
    margin-bottom: 0.5rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--accent-primary);
    background: var(--clay-bg-secondary);
    box-shadow:
      inset 2px 2px 4px var(--clay-shadow-dark),
      inset -2px -2px 4px var(--clay-shadow-light);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .toc-sidebar {
      display: none;
    }
  }

  /* Scrollbar styling */
  .toc-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .toc-sidebar::-webkit-scrollbar-track {
    background: var(--clay-bg-secondary);
    border-radius: 3px;
  }

  .toc-sidebar::-webkit-scrollbar-thumb {
    background: var(--clay-shadow-dark);
    border-radius: 3px;
  }

  .toc-sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--text-tertiary);
  }
</style>
