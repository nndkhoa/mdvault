---
import type { TOCItem } from "@/lib/toc";
import Icon from "./icons/Icon.astro";

interface Props {
  toc: TOCItem[];
}

const { toc } = Astro.props;

function renderTOCItem(item: TOCItem) {
  return {
    ...item,
    hasChildren: item.children && item.children.length > 0,
  };
}
---

{
  toc.length > 0 && (
    <aside
      class="toc-sidebar"
      role="complementary"
      aria-label="Table of contents"
    >
      <nav class="toc">
        <div class="toc-header">
          <Icon name="list-bullet" size="md" class="toc-header-icon" />
          <h2 class="toc-title">Contents</h2>
        </div>
        <ul class="toc-list">
          {toc.map((item) => {
            const tocItem = renderTOCItem(item);
            return (
              <li class="toc-item">
                <a href={`#${item.id}`} class="toc-link">
                  {item.text}
                </a>
                {tocItem.hasChildren && (
                  <ul class="toc-list toc-nested">
                    {item.children.map((child) => (
                      <li class="toc-item">
                        <a href={`#${child.id}`} class="toc-link">
                          {child.text}
                        </a>
                        {child.children && child.children.length > 0 && (
                          <ul class="toc-list toc-nested">
                            {child.children.map((grandchild) => (
                              <li class="toc-item">
                                <a href={`#${grandchild.id}`} class="toc-link">
                                  {grandchild.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>
  )
}

<style>
  .toc-sidebar {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--bg-elevated);
    border-radius: 12px;
    border: 1px solid var(--border-primary);
    box-shadow: var(--shadow-sm);
    max-height: calc(100vh - 3rem);
    overflow: hidden;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
  }

  .toc {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .toc-list {
    overflow-y: auto;
    overflow-x: hidden;
    flex: 1;
    margin: 0;
    padding: 0;
  }

  .toc-header-icon {
    color: var(--accent-primary);
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-nested {
    margin-left: 1rem;
    margin-top: 0.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border-primary);
  }

  .toc-item {
    margin-bottom: 0.375rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0.625rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    line-height: 1.5;
  }

  .toc-link:hover {
    color: var(--accent-primary);
    background: var(--bg-secondary);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .toc-sidebar {
      display: none;
    }
  }

  /* Scrollbar styling for TOC list */
  .toc-list::-webkit-scrollbar {
    width: 5px;
  }

  .toc-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--border-secondary);
    border-radius: 10px;
  }

  .toc-list::-webkit-scrollbar-thumb:hover {
    background: var(--text-tertiary);
  }
</style>
